# =====================================================================
# Yandex Wordstat skill — optional .env (secrets, never commit)
# =====================================================================
# Usually NOT needed: put everything into config.json (see config/README.md).
# Place this file next to config.json — in ~/.config/yandex-wordstat/
# (recommended, survives plugin updates) or in the skill's config/ folder.
#
# Backend auto-selection (priority):
#   1. YANDEX_WORDSTAT_BACKEND=legacy|cloud  (explicit override)
#   2. config.json with folder id + api key or SA key file → cloud
#   3. YANDEX_WORDSTAT_TOKEN set                         → legacy
#   4. Nothing                                           → error
# Cloud wins on tie.

# --- Cloud mode: API key instead of auth.api_key in config.json ---
# Service account API key with scope yc.search-api.execute.
# YANDEX_CLOUD_API_KEY=your_api_key_here

# --- Legacy mode (old OAuth API; Yandex no longer issues new tokens) ---
# Tokens expire after 1 year.
# YANDEX_WORDSTAT_TOKEN=your_token_here

# Optional: pin backend explicitly. Values: legacy | cloud
# YANDEX_WORDSTAT_BACKEND=cloud
