# =====================================================================
# yandex-webmaster — credentials
# =====================================================================
# OAuth-токен Яндекса с правами Вебмастера (webmaster:hostinfo).
# Получить:  bash scripts/get_token.sh --client-id <CLIENT_ID>
# Токены живут ~1 год — check_token.sh предупредит о сроке.
YANDEX_WEBMASTER_TOKEN=your_token_here

# Целевой домен (без протокола). host_id резолвится автоматически,
# приоритет — https-зеркало этого домена.
YANDEX_WEBMASTER_HOST=nacifrah.ru

# Опционально: жёстко задать host_id и пропустить авторезолв.
# Формат как в API: протокол:домен:порт
# YANDEX_WEBMASTER_HOST_ID=https:nacifrah.ru:443
